# ==============================================================================
# SMART BAKERY & CAFÉ - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the server directory and configure your actual values.
# NEVER commit your actual '.env' file containing real secrets to version control.

# Server Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Connection URI)
# Local: mongodb://127.0.0.1:27017/smart_bakery_cafe
# Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_bakery_cafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_bakery_cafe

# Authentication & JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars_bakery
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Default Store Geolocation & 5 KM Delivery Parameters
# Example coordinates: Connaught Place, New Delhi (Lat: 28.6315, Lng: 77.2167)
BAKERY_NAME=Smart Bakery & Café
BAKERY_LAT=28.6315
BAKERY_LNG=77.2167
DELIVERY_MAX_RADIUS_KM=5.0
DELIVERY_BASE_FEE=40
FREE_DELIVERY_THRESHOLD=500
TAX_RATE_PERCENTAGE=5

# Payment Gateway (Razorpay Test Mode)
# Leave empty or set to 'mock' to use internal simulated payment mode
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Initial Admin Seeding Account (Used by npm run seed:admin)
INITIAL_ADMIN_NAME=Admin Manager
INITIAL_ADMIN_EMAIL=admin@smartbakery.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!
INITIAL_ADMIN_PHONE=9876543210

# Pickup QR Verification Secret (HMAC secret for generating and verifying pickup QR tokens)
QR_HMAC_SECRET=secure_qr_pickup_verification_token_key_2026
