# ==============================================================================
# SMART BAKERY & CAFÉ - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' in the client directory and configure your actual values.

# Backend API Root URL (No trailing slash)
VITE_API_URL=http://localhost:5000/api

# Backend Base URL (for Socket.IO and static assets)
VITE_SERVER_URL=http://localhost:5000

# Optional Map Provider Key (Mapbox or Google Maps, if visual tile maps are enabled)
# If blank, Leaflet with OpenStreetMap / Native Geolocation fallback is used with zero paid API keys needed
VITE_MAP_PROVIDER=osm
VITE_MAPBOX_TOKEN=

# Razorpay Key ID for client-side checkout popup (Test Mode)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
